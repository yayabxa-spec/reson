{
  "compilerOptions": {
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/icons/*": [
        "./assets/icon/*"
      ],
      "@/pages/*": [
        "./app/pages/*"
      ],
      "@/hooks/*": [
        "./app/hooks/*"
      ],
      "@/utils/*": [
        "./app/utils/*"
      ],
      "@/component/*": [
        "./app/component/*"
      ],
      "@/theme/*": [
        "./theme/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/mocks/*": [
        "./mocks/*"
      ],
    }
  },
  "extends": "expo/tsconfig.base",
  "tscFilesIncludes": [
    "/@types/"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
